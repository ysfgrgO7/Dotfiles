* {
    bg: #1e1e2e;      /* Catppuccin Mocha colors */
    fg: #cdd6f4;
    accent: #89b4fa;
    border: #313244;
    
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 650px;
    background-color: @bg;
    border: 2px;
    border-radius: 12px;
    border-color: @border;
    location: center;
    anchor: center;
    y-offset: -15%;
}

mainbox {
    children: [ inputbar, listview, mode-switcher ];
}

inputbar {
    padding: 20px;
    children: [ prompt, entry ];
}

prompt {
    padding: 0 10px 0 0;
    text-color: @accent;
}

entry {
    placeholder: "Search...";
    placeholder-color: #585b70;
}

listview {
    columns: 1;
    lines: 10;
    padding: 10px;
    spacing: 5px;
    fixed-height: false;
}

element {
    padding: 8px;
    border-radius: 6px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon { size: 24px; }

mode-switcher {
    padding: 0 10px 10px 10px;
}

button {
    padding: 5px;
    border-radius: 4px;
}

button selected {
    background-color: @accent;
    text-color: @bg;
}